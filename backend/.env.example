# Port the API listens on
PORT=4000

# Required for accounts, sessions, connections, and messages
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. If set, MESH uses Claude to parse free-text search queries and
# write the "why you matched" explanations. If left blank, MESH falls back
# to a fast built-in keyword parser — the app works fully without a key.
ANTHROPIC_API_KEY=

# Model to use when ANTHROPIC_API_KEY is set
ANTHROPIC_MODEL=claude-sonnet-4-6
